---
// src/layouts/Layout.astro
interface Props {
	title: string;
	description: string;
	titlePosition?: 'before' | 'after';
	noindex?: boolean;
	socialImage?: string;
	socialImageAlt?: string;
	socialImageWidth?: number;
	socialImageHeight?: number;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description,
	titlePosition = 'after',
	noindex = false,
	socialImage = '/img/maravilla_whatsapp.webp',
	socialImageAlt = 'Maravilla Films',
	socialImageWidth = 1200,
	socialImageHeight = 630,
	structuredData,
} = Astro.props;
const siteName = 'Maravilla Films';
const fullTitle = titlePosition === 'before' ? `${siteName} | ${title}` : `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://maravillafilms.com');
const socialImageURL = new URL(socialImage, Astro.site ?? 'https://maravillafilms.com');
const isHomePage = Astro.url.pathname === '/';
const organizationData = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': 'https://maravillafilms.com/#organization',
	name: siteName,
	legalName: 'Cumbre Serena World Productions, S.L.',
	url: 'https://maravillafilms.com/',
	logo: 'https://maravillafilms.com/img/logo_maravilla_opt.webp',
	image: 'https://maravillafilms.com/img/maravilla_whatsapp.webp',
	description: 'Productora cinematográfica independiente dedicada al desarrollo y producción de cortometrajes, documentales y proyectos audiovisuales.',
	email: 'producciones@maravillafilms.com',
	telephone: '+34 622 360 554',
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Parc Audiovisual de Catalunya, 11',
		addressLocality: 'Terrassa',
		addressRegion: 'Barcelona',
		postalCode: '08225',
		addressCountry: 'ES',
	},
	sameAs: [
		'https://www.instagram.com/maravillafilms/',
		'https://www.tiktok.com/@maravillafilms?lang=es',
		'https://www.linkedin.com/in/maravillafilms-56523a3b6/',
	],
};
const websiteData = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': 'https://maravillafilms.com/#website',
	url: 'https://maravillafilms.com/',
	name: siteName,
	inLanguage: 'es',
	publisher: { '@id': 'https://maravillafilms.com/#organization' },
};
const pageStructuredData = structuredData
	? (Array.isArray(structuredData) ? structuredData : [structuredData])
	: [];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{fullTitle}</title>
		<link rel="canonical" href={canonicalURL} />
		
		<link rel="icon" type="image/png" href="/img/favicon-96.png" />
		
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="es_ES" />
		
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content={String(socialImageWidth)} />
		<meta property="og:image:height" content={String(socialImageHeight)} />
		<meta property="og:image:alt" content={socialImageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		{isHomePage && <script type="application/ld+json" set:html={JSON.stringify([organizationData, websiteData])} />}
		{pageStructuredData.map((data) => (
			<script type="application/ld+json" set:html={JSON.stringify(data)} />
		))}
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,700;1,700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
	</head>
	<body>
		
		<header class="site-header">
	<div class="header-container">
		
		<!-- MÓVIL: solo dejamos el tag <img> -->
		<div class="mobile-header">
			<a href="/" class="logo-link">
				<img src="/img/logo_maravilla_large_opt.webp" alt="Logo Maravilla Films" class="header-logo-img" />
			</a>
			<div class="mobile-actions">
				<button aria-label="Menú" id="btn-menu">
					<svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
				</button>
			</div>
		</div>

		<!-- ESCRITORIO: solo dejamos el tag <img> -->
		<div class="desktop-header">
			<div class="logo-wrapper">
				<a href="/" class="logo-link-large">
					<img src="/img/logo_maravilla_large_opt.webp" alt="Logo Maravilla Films" class="header-logo-img-large" />
				</a>
			</div>
			
			<div class="nav-wrapper">
				<nav class="main-nav">
					<ul>
						<li><a href="/">INICIO</a></li>
						<li><a href="/about">QUIÉNES SOMOS</a></li>
						<li><a href="/catalogo">CATÁLOGO</a></li>
						<!-- <li><a href="/editorial">EDITORIAL</a></li> -->
						<li><a href="/contact">CONTACTO</a></li>
					</ul>
				</nav>
			</div>
		</div>

	</div>
</header>

		<div class="mobile-nav-overlay" id="mobile-menu">
			<nav class="mobile-nav-drawer">
				<div class="drawer-header">
					<img src="/img/logo_maravilla_large_opt.webp" alt="Logo Maravilla Films" class="drawer-logo" />
					<button id="btn-close-menu" aria-label="Cerrar Menú">
						<svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
					</button>
				</div>
				<ul class="drawer-links">
					<li><a href="/">INICIO</a></li>
					<li><a href="/about">QUIÉNES SOMOS</a></li>
					<li><a href="/catalogo">CATÁLOGO</a></li>
					<!-- <li><a href="/editorial">EDITORIAL</a></li> -->
					<li><a href="/contact">CONTACTO</a></li>
				</ul>
			</nav>
		</div>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-content">
				
				<img src="/img/logo_maravilla_opt.webp" alt="Logo Maravilla Films" class="footer-logo-img">
				
				<div class="footer-social">
					<a href="https://www.instagram.com/maravillafilms/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
						<svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
					</a>
					<a href="https://www.tiktok.com/@maravillafilms?lang=es" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
						<svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
					</a>
					<a href="https://www.linkedin.com/in/maravillafilms-56523a3b6/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
						<svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
					</a>
				</div>
				
				<div class="footer-legal">
					<a href="/privacidad">Política de Privacidad</a>
					<span class="separator">·</span>
					<a href="/cookies">Política de Cookies</a>
					<span class="separator">·</span>
					<a href="/aviso-legal">Aviso Legal</a>
				</div>

			</div>
			
			<div class="footer-bottom">
				<p>© 2026 Maravilla Films. Todos los derechos reservados.</p>
			</div>
		</footer>

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const siteHeader = document.querySelector('.site-header');
				const btnMenu = document.getElementById('btn-menu');
				const btnClose = document.getElementById('btn-close-menu');
				const mobileMenu = document.getElementById('mobile-menu');
				const menuLinks = document.querySelectorAll('.drawer-links a');

				if (siteHeader) {
					let scrollFrame: number | null = null;

					const updateHeader = () => {
						const progress = Math.min(Math.max(window.scrollY / 140, 0), 1);
						const headerElement = siteHeader as HTMLElement;
						headerElement.style.setProperty('--header-padding-top', `${32 - (23.2 * progress)}px`);
						headerElement.style.setProperty('--header-padding-bottom', `${24 - (12.8 * progress)}px`);
						headerElement.style.setProperty('--header-logo-margin', `${24 - (18.4 * progress)}px`);
						headerElement.style.setProperty('--header-logo-height', `${120 - (62 * progress)}px`);
						headerElement.style.setProperty('--header-shadow-y', `${8 * progress}px`);
						headerElement.style.setProperty('--header-shadow-blur', `${24 * progress}px`);
						headerElement.style.setProperty('--header-shadow-opacity', `${0.28 * progress}`);
						scrollFrame = null;
					};

					const requestHeaderUpdate = () => {
						if (scrollFrame === null) {
							scrollFrame = window.requestAnimationFrame(updateHeader);
						}
					};

					updateHeader();
					window.addEventListener('scroll', requestHeaderUpdate, { passive: true });
				}

				if(btnMenu && mobileMenu) {
					btnMenu.addEventListener('click', () => {
						mobileMenu.classList.add('is-open');
						document.body.style.overflow = 'hidden'; 
					});
				}

				if(btnClose && mobileMenu) {
					btnClose.addEventListener('click', () => {
						mobileMenu.classList.remove('is-open');
						document.body.style.overflow = '';
					});
				}

				if(mobileMenu) {
					mobileMenu.addEventListener('click', (e) => {
						if (e.target === mobileMenu) {
							mobileMenu.classList.remove('is-open');
							document.body.style.overflow = '';
						}
					});
				}

				// Cierra el menú al hacer clic en secciones ancla como #proyectos
				menuLinks.forEach(link => {
					link.addEventListener('click', () => {
						if (mobileMenu) {
							mobileMenu.classList.remove('is-open');
							document.body.style.overflow = '';
						}
					});
				});
			});
		</script>

	</body>
</html>

<style is:global lang="scss">
	/* ==========================================
	   1. VARIABLES DE DISEÑO (SASS + NATIVAS)
	   ========================================== */
	$color-bg:        #000000;
	$color-surface:   #101114;
	$color-surface-raised: #17181B;
	$color-surface-deep: #0D0E10;
	$color-bg-light:  #B0AEAF;
	$color-text:      #F5F5F5;
	$color-accent:    #0050FB;
	$font-body:       'Playfair Display', 'Montserrat', 'Cinzel', serif;
	$font-title:      'Barlow', 'Poppins', 'Inter', sans-serif;
	$max-width-site:  1200px;

	:root {
		--site-bg: #{$color-bg};
		--site-surface: #{$color-surface};
		--site-surface-raised: #{$color-surface-raised};
		--site-surface-deep: #{$color-surface-deep};
		--site-bg-light: #{$color-bg-light};
		--site-text: #{$color-text};
		--site-text-strong: rgba(245, 245, 245, 0.95);
		--site-text-soft: rgba(245, 245, 245, 0.8);
		--site-text-muted: rgba(245, 245, 245, 0.72);
		--site-text-subtle: rgba(245, 245, 245, 0.4);
		--site-text-faint: rgba(245, 245, 245, 0.3);
		--site-ink: #171717;
		--site-ink-soft: #333333;
		--site-ink-muted: #555555;
		--site-accent: #{$color-accent};
		--site-border-subtle: rgba(255, 255, 255, 0.08);
		--site-border: rgba(255, 255, 255, 0.12);
		--site-border-decorative: rgba(255, 255, 255, 0.22);
		--site-border-strong: rgba(255, 255, 255, 0.28);
		--site-border-dark: rgba(0, 0, 0, 0.1);
		--button-radius: 3px;
		--button-min-height: 44px;
		--button-padding: 0.75rem 1.5rem;
		--font-body: #{$font-body};
		--font-title: #{$font-title};
	}

	/* ==========================================
	   2. RESETS GLOBALES Y TIPOGRAFÍA BASE
	   ========================================== */
	*, *::before, *::after { 
		box-sizing: border-box;
		margin: 0; 
		padding: 0; 
	}
	
	html { 
		scroll-behavior: auto !important; 
	}
	
	body { 
		font-family: var(--font-body);
		color: var(--site-ink-soft);
		background-color: var(--site-bg-light);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
	
	h1, h2, h3, h4, .logo-link, .logo-link-large, nav a, button {
		font-family: var(--font-title);
	}
	
	a { text-decoration: none; color: inherit; }
	ul { list-style: none; }
	button { background: none; border: none; cursor: pointer; color: inherit; }

	/* Texto accesible para títulos representados visualmente mediante logotipos. */
	.sr-only.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* ==========================================
	   3. HEADER GENERAL & STICKY
	   ========================================== */
	.site-header {
		background-color: var(--site-bg); 
		border-bottom: 1px solid var(--site-border-subtle);
		position: sticky;
		top: 0;
		z-index: 999;
		transition: box-shadow 0.35s ease;
	}
	
	.header-container { 
		width: 100%;
		max-width: $max-width-site;
		margin: 0 auto; 
		padding: 0 1rem;
	}

	/* ==========================================
	   4. MARCA Y LOGO (COMÚN MOBILE/DESKTOP)
	   ========================================== */
	.logo-link, .logo-link-large {
	display: inline-flex;
	align-items: center;
	justify-content: center;
}
	
	.header-logo-img {
		height: auto;
		opacity: 0.95;
	}

	.logo-text-group {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		line-height: 1;
	}

	.brand-title {
		font-family: var(--font-title);
		color: var(--site-ink-soft);
		display: flex;       
		align-items: baseline; 
		
		strong { 
			color: var(--site-ink);
			font-weight: 700;
			margin-left: 0.2rem; 
		}
	}

	.logo-accent {
		display: block;
		font-family: sans-serif;
		font-style: normal !important; 
		font-weight: 700;
		color: var(--site-accent);
		text-align: left;
	}

	/* ==========================================
	   5. HEADER VERSIÓN MÓVIL (MOBILE FIRST)
	   ========================================== */
	.mobile-header {
		display: flex; 
		justify-content: space-between; 
		align-items: center;
		height: 70px; /* Incrementado ligeramente para dar más espacio visual al logo */
		
		.logo-link { gap: 0.6rem; }
		.header-logo-img { 
		height: 48px; /* Ajusta este valor si necesitas que el logo sea más grande o pequeño en móvil */
		width: auto;
		object-fit: contain;
		}
		.brand-title { font-size: 1.1rem; }
		.logo-accent { 
			font-size: 0.55rem; 
			letter-spacing: 2px;
			margin-top: 3px; 
		}
	}

	.mobile-actions { 
		display: flex; 
		gap: 1rem; 
		color: var(--site-accent); 
	}

	.desktop-header { display: none; } 

	/* ==========================================
	   6. HEADER VERSIÓN DESKTOP (PC)
	   ========================================== */
	@media (min-width: 1024px) {
	body {
		padding-top: 211px;
	}

	.site-header {
		--header-padding-top: 32px;
		--header-padding-bottom: 24px;
		--header-logo-margin: 24px;
		--header-logo-height: 120px;
		--header-shadow-y: 0px;
		--header-shadow-blur: 0px;
		--header-shadow-opacity: 0;
		position: fixed;
		left: 0;
		right: 0;
		box-shadow: 0 var(--header-shadow-y) var(--header-shadow-blur) rgba(0, 0, 0, var(--header-shadow-opacity));
	}

	.mobile-header { display: none; }
	
	.desktop-header { 
		display: flex; 
		flex-direction: column; 
		align-items: center; 
		padding: var(--header-padding-top) 0 var(--header-padding-bottom);
	}
	
	.logo-wrapper { 
		margin-bottom: var(--header-logo-margin);
		width: 100%;
		display: flex;
		justify-content: center;
	}
		.logo-link-large { gap: 0.8rem; }
		
		.desktop-header {
			.header-logo-img-large { 
		max-height: var(--header-logo-height); /* Controla la altura máxima en PC */
		width: auto;
		max-width: 100%;
		object-fit: contain;
		transition: transform 0.3s ease;

		&:hover {
			transform: scale(1.02); /* Sutil efecto hover al pasar el ratón */
		}
	}
			.brand-title { font-size: 2.2rem; letter-spacing: 1px; }
			.logo-accent { font-size: 0.7rem; letter-spacing: 4px; margin-top: 6px; }
		}

		/* MENÚ DE NAVEGACIÓN PC */
		.nav-wrapper { 
			display: flex; 
			width: 100%; 
			justify-content: center; 
			align-items: center; 
		}
		
		.main-nav ul { 
			display: flex;
			align-items: center; 
			gap: 0.5rem; 
		}
		
		.main-nav li {
			position: relative; 
			padding: 0 1.5rem;
			
			&:not(:last-child)::after {
				content: ''; 
				position: absolute; 
				right: 0; 
				top: 50%;
				transform: translateY(-50%);
				height: 12px; 
				width: 1px; 
				background-color: var(--site-border-strong);
			}
		}
		
		.main-nav a {
			font-size: 0.9rem; 
			font-weight: 700; 
			color: var(--site-text-muted);
			transition: color 0.2s;
			text-transform: uppercase; 
			letter-spacing: 1px;
			
			&:hover, &.active { color: var(--site-accent); }
		}

	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.desktop-header .header-logo-img-large {
			transition: none;
		}
	}

	/* ==========================================
	   7. FOOTER PRINCIPAL
	   ========================================== */
	.site-footer {
		background-color: var(--site-bg);
		padding: 4rem 1.5rem 2rem 1.5rem;
		text-align: center;
	}
	
	.footer-content {
		display: flex; 
		flex-direction: column; 
		align-items: center; 
		width: 100%;
		max-width: $max-width-site; 
		margin: 0 auto;
	}
	
	.footer-logo-img { 
		width: clamp(5rem, 10vw, 10rem);
  		height: auto;
		margin-bottom: 1rem;
		opacity: 0.9; 
	}
	
	.footer-logo-text {
		font-family: var(--font-title); 
		font-size: 1.2rem; 
		letter-spacing: 4px;
		color: var(--site-text-soft);
		margin-bottom: 2rem; 
		text-transform: uppercase;
	}
	
	.footer-social {
		display: flex; 
		justify-content: center; 
		gap: 2rem; 
		margin-bottom: 2rem;
		
		a {
			color: var(--site-accent); 
			transition: color 0.3s ease, transform 0.2s ease;
			&:hover { 
				color: var(--site-text);
				transform: translateY(-3px); 
			}
		}
	}
	
	.footer-legal {
		margin-bottom: 3rem;
		
		a, .separator {
			color: var(--site-text-subtle);
			text-decoration: none; 
			font-size: 0.8rem;
			font-family: var(--font-title); 
			margin: 0 0.5rem; 
			transition: color 0.2s;
		}
		
		a:hover { color: var(--site-accent); }
	}
	
	.footer-bottom {
		border-top: 1px solid var(--site-border-subtle);
		padding-top: 2rem; 
		width: 100%;
		max-width: $max-width-site; 
		margin: 0 auto;
		
		p {
			color: var(--site-text-faint);
			font-size: 0.75rem; 
			font-family: var(--font-title);
			margin: 0;
		}
	}

	/* ==========================================
	   8. ESTILOS DEL MENÚ DESPLIEGUE MÓVIL (NUEVO)
	   ========================================== */
	.mobile-nav-overlay {
		position: fixed;
		top: 0; left: 0; width: 100%; height: 100%;
		background-color: rgba(0, 0, 0, 0.75);
		backdrop-filter: blur(4px);
		z-index: 9999;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.3s ease, visibility 0.3s ease;

		&.is-open {
			opacity: 1;
			visibility: visible;
			
			.mobile-nav-drawer {
				transform: translateX(0);
			}
		}
	}

	.mobile-nav-drawer {
		position: absolute;
		top: 0; right: 0;
		width: 80%; max-width: 320px;
		height: 100%;
		background-color: var(--site-bg);
