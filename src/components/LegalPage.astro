---
interface Props {
	title: string;
	updated: string;
}

const { title, updated } = Astro.props;
---

<section class="legal-page">
	<header class="legal-header">
		<p class="legal-eyebrow">INFORMACIÓN LEGAL</p>
		<h1>{title}</h1>
		<p class="legal-updated">Última actualización: {updated}</p>
	</header>

	<article class="legal-content">
		<slot />
	</article>
</section>

<style lang="scss">
	.legal-page {
		background-color: var(--test-bg-page);
		color: #171717;
	}

	.legal-header {
		padding: 4rem 1.5rem;
		background-color: var(--site-bg);
		color: #ffffff;
		text-align: center;

		@media (min-width: 768px) {
			padding: 5rem 2rem;
		}
	}

	.legal-eyebrow {
		margin-bottom: 1rem;
		font-family: var(--font-title);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		color: var(--site-accent);
	}

	h1 {
		font-family: var(--font-title);
		font-size: clamp(2rem, 8vw, 3.5rem);
		line-height: 1.1;
	}

	.legal-updated {
		margin-top: 1.25rem;
		font-size: 0.95rem;
		color: rgba(255, 255, 255, 0.65);
	}

	.legal-content {
		max-width: 900px;
		margin: 0 auto;
		padding: 3rem 1.5rem 5rem;

		@media (min-width: 768px) {
			padding: 4.5rem 2rem 7rem;
		}

		:global(h2) {
			margin: 2.75rem 0 1rem;
			font-family: var(--font-title);
			font-size: clamp(1.3rem, 4vw, 1.75rem);
			line-height: 1.25;
			color: #111111;
		}

		:global(h2:first-child) {
			margin-top: 0;
		}

		:global(h3) {
			margin: 1.75rem 0 0.75rem;
			font-family: var(--font-title);
			font-size: 1.05rem;
			color: #171717;
		}

		:global(p),
		:global(li) {
			font-size: 1rem;
			line-height: 1.75;
			color: #282828;
		}

		:global(p + p) {
			margin-top: 1rem;
		}

		:global(ul) {
			display: grid;
			gap: 0.7rem;
			margin: 1rem 0 0;
			padding-left: 1.25rem;
			list-style: disc;
		}

		:global(a) {
			color: #003fc7;
			text-decoration: underline;
			text-underline-offset: 3px;
		}

		:global(strong) {
			font-family: var(--font-title);
			font-weight: 700;
		}
	}
</style>
