---
// src/pages/editorial.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Editorial" description="Sección Editorial - Próximamente">
	<section class="coming-soon-section">
		<div class="content-wrapper">
			
			<div class="icon-wrapper">
				<svg viewBox="0 0 24 24" width="50" height="50" stroke="var(--site-accent)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
					<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
				</svg>
			</div>
			
			<h1 class="page-title">EDITORIAL</h1>
			
			<div class="status-badge">PRÓXIMAMENTE</div>
			
			<p class="description">
				Estamos construyendo un nuevo espacio dedicado a la reflexión, los guiones y la memoria visual de nuestras producciones. La literatura cinematográfica está en camino.
			</p>
			
			<a href="/" class="btn-back">VOLVER AL INICIO</a>
			
		</div>
	</section>
</Layout>

<style lang="scss">
	/* ==========================================
	   ESTILOS DE LA PÁGINA "EN CONSTRUCCIÓN"
	   ========================================== */
	.coming-soon-section {
		width: 100%;
		/* Altura mínima de toda la pantalla menos la cabecera para que quede centrado */
		min-height: calc(100vh - 100px); 
		display: flex;
		justify-content: center;
		align-items: center;
		background-color: var(--site-bg);
		padding: 2rem;
		position: relative;
		overflow: hidden;
	}

	/* Efecto sutil de luz de fondo para que no sea un negro plano */
	.coming-soon-section::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 50vw;
		height: 50vw;
		background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 60%);
		z-index: 0;
		pointer-events: none;
	}

	.content-wrapper {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		max-width: 600px;
		animation: fadeIn 1s ease-out;
	}

	.icon-wrapper {
		margin-bottom: 1.5rem;
		opacity: 0.9;
	}

	.page-title {
		font-family: var(--font-title);
		font-size: 3rem;
		color: #ffffff;
		letter-spacing: 12px;
		margin: 0 0 1.5rem 0;
		font-weight: 300;

		@media (min-width: 768px) {
			font-size: 4.5rem;
			letter-spacing: 18px;
		}
	}

	.status-badge {
		font-family: var(--font-title);
		background-color: var(--site-accent);
		color: #ffffff;
		padding: 0.5rem 1.5rem;
		border-radius: 2px;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 3px;
		margin-bottom: 2.5rem;
		display: inline-block;
	}

	.description {
		font-family: var(--font-body);
		color: rgba(255, 255, 255, 0.7);
		font-size: 1.1rem;
		line-height: 1.7;
		margin-bottom: 3.5rem;
	}

	.btn-back {
		font-family: var(--font-title);
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.3);
		padding: 0.8rem 2.5rem;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 2px;
		transition: all 0.3s ease;
		background: transparent;

		&:hover {
			background-color: #ffffff;
			color: var(--site-bg);
			border-color: #ffffff;
		}
	}

	/* Animación de entrada suave */
	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(20px); }
		to { opacity: 1; transform: translateY(0); }
	}
</style>