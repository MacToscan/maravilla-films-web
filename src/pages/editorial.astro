---
import Layout from '../layouts/Layout.astro';

const libros = [
	{
		titulo: 'El poder de una lágrima',
		autor: 'Marc Toscano Martín',
		genero: 'Ciencia ficción/Fantasía',
		destacado: 'Una lágrima puede cambiarlo todo.',
		sinopsis: [
			{ texto: 'La humanidad vive en un equilibrio impecable. ' },
			{ texto: 'No existen las guerras, el caos ni el sufrimiento.', negrita: true },
			{ texto: ' Todo es orden. Jonathan, un científico entregado a su trabajo, jamás ha tenido motivos para dudar de esa realidad, hasta que ' },
			{ texto: 'una expedición a la Antártida lo cambia todo.', negrita: true },
			{ texto: ' Allí, una sola lágrima desata una reacción que lo conducirá hacia civilizaciones olvidadas y una guerra ancestral por el destino de la especie.' },
		],
		portada: '/img/editorial_el_poder_lagrima.webp',
		alt: 'Portada de El poder de una lágrima, de Marc Toscano Martín',
		ruta: '/editorial/el-poder-de-una-lagrima',
	},
	{
		titulo: 'Carne y Cal',
		autor: 'Martín Barroso',
		genero: 'Thriller psicológico/Terror',
		destacado: 'Las paredes también guardan secretos.',
		sinopsis: [
			{ texto: 'Julián es un joven artista atrapado en una dolorosa ruptura y una profunda crisis de inspiración. Su realidad cambia cuando ' },
			{ texto: 'recibe en herencia una antigua casa de Bélmez de la Moraleda.', negrita: true },
			{ texto: ' Lo que comienza como una luminosa tregua entre amigos se rompe cuando ' },
			{ texto: 'las paredes empiezan a manifestar intenciones propias.', negrita: true },
		],
		portada: '/img/editorial_carne_cal.webp',
		alt: 'Portada de Carne y Cal, de Martín Barroso',
		ruta: '/editorial/carne-y-cal',
	},
];
---

<Layout
	title="Editorial Cumbre Serena"
	description="Editorial Cumbre Serena, una editorial de Maravilla Films. Historias que también se leen."
	noindex={true}
>
	<section class="editorial-hero" aria-labelledby="editorial-title">
		<div class="hero-glow" aria-hidden="true"></div>
		<div class="editorial-brand">
			<img src="/img/editorial_cumbre_icon.webp" alt="" class="editorial-icon" />
			<div>
				<p class="brand-name">CUMBRE SERENA</p>
				<p class="brand-label">EDITORIAL</p>
			</div>
		</div>

		<p class="eyebrow">UNA EDITORIAL DE MARAVILLA FILMS</p>
		<h1 id="editorial-title">Historias que también<br />se leen.</h1>
		<p class="hero-copy">
			Un nuevo espacio para relatos con identidad propia, voces singulares y mundos que continúan mucho después de cerrar el libro.
		</p>
	</section>

	<section class="books-section" aria-labelledby="books-title">
		<div class="books-container">
			<header class="section-heading">
				<div>
					<p class="section-kicker">Editorial cumbre serena</p>
					<h2 id="books-title">Nuestros libros</h2>
				</div>
				<p class="section-count">01—02</p>
			</header>

			<div class="books-grid">
				{libros.map((libro, index) => (
					<article class="book-card">
						<div class="cover-column">
							<div class="book-cover-wrap">
								<span class="cover-status">DISPONIBLE</span>
								<img src={libro.portada} alt={libro.alt} class="book-cover" loading={index === 0 ? 'eager' : 'lazy'} />
							</div>
						</div>

						<div class="book-info">
							<h3>{libro.titulo}</h3>
							<p class="book-author">{libro.autor}</p>
							<p class="book-genre">{libro.genero}</p>
							<p class="book-highlight">{libro.destacado}</p>
							<p class="book-synopsis">
								{libro.sinopsis.map((fragmento) => fragmento.negrita ? <strong>{fragmento.texto}</strong> : fragmento.texto)}
							</p>
							<a class="book-action" href={libro.ruta} aria-label={`Leer más sobre ${libro.titulo}`}>
								LEER MÁS
								<span aria-hidden="true">→</span>
							</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>
</Layout>

<style lang="scss">
	.editorial-hero {
		position: relative;
		display: flex;
		min-height: 510px;
		padding: 4.5rem 1.5rem 5rem;
		overflow: hidden;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background: linear-gradient(180deg, rgba(0, 80, 251, 0.05), transparent 55%), var(--site-bg);
		color: var(--site-text);
		text-align: center;
	}

	.hero-glow {
		position: absolute;
		top: -12rem;
		left: 50%;
		width: 34rem;
		height: 34rem;
		transform: translateX(-50%);
		border-radius: 50%;
		background: radial-gradient(circle, rgba(0, 80, 251, 0.13), transparent 68%);
		pointer-events: none;
	}

	.editorial-brand {
		position: relative;
		display: inline-flex;
		margin-bottom: 3.5rem;
		align-items: center;
		gap: 0.9rem;
		text-align: left;
	}

	.editorial-icon { width: 54px; height: 54px; object-fit: contain; }

	.brand-name,
	.brand-label,
	.eyebrow,
	.section-kicker,
	.book-status,
	.cover-status,
	.book-genre,
	.book-action,
	.section-count {
		font-family: var(--font-title);
		font-weight: 700;
		text-transform: uppercase;
	}

	.brand-name {
		margin: 0;
		color: #10a9bd;
		font-size: 1rem;
		letter-spacing: 0.12em;
		line-height: 1;
	}

	.brand-label {
		margin: 0.4rem 0 0;
		color: var(--site-text-muted);
		font-size: 0.58rem;
		letter-spacing: 0.35em;
		text-align: center;
	}

	.eyebrow {
		position: relative;
		margin: 0 0 1.25rem;
		color: #10a9bd;
		font-size: 0.68rem;
		letter-spacing: 0.24em;
	}

	.editorial-hero h1 {
		position: relative;
		margin: 0;
		font-family: var(--font-body);
		font-size: clamp(2.7rem, 12vw, 5.8rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 0.96;
	}

	.hero-copy {
		position: relative;
		max-width: 620px;
		margin: 1.8rem 0 0;
		color: var(--site-text-muted);
		font-size: 1rem;
		line-height: 1.7;
	}

	.books-section { padding: 4.5rem 1.25rem 6rem; background: var(--site-surface-deep); color: var(--site-text); }
	.books-container { width: 100%; max-width: 1200px; margin: 0 auto; }

	.section-heading {
		display: flex;
		margin-bottom: 3rem;
		padding-bottom: 1.25rem;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px solid var(--site-border);
	}

	.section-kicker { margin: 0 0 0.65rem; color: #10a9bd; font-size: 0.64rem; letter-spacing: 0.2em; }
	.section-heading h2 { margin: 0; font-size: clamp(2rem, 9vw, 3.8rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1; }
	.section-count { margin: 0; color: var(--site-text-subtle); font-size: 0.7rem; letter-spacing: 0.16em; }
	.books-grid { display: grid; gap: 5rem; }

	.book-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.75rem;
		align-items: start;
	}

	.cover-column { position: relative; display: flex; justify-content: center; }

	.book-cover-wrap {
		position: relative;
		z-index: 1;
		width: min(48vw, 190px);
		aspect-ratio: 0.665;
		overflow: hidden;
		background: var(--site-surface);
		box-shadow: 0 22px 48px rgba(0, 0, 0, 0.46);
		transition: transform 0.4s ease, box-shadow 0.4s ease;
	}

	.book-cover-wrap::after { content: ''; position: absolute; inset: 0; border: 1px solid rgba(255, 255, 255, 0.08); pointer-events: none; }

	.cover-status {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 2;
		padding: 0.55rem 0.8rem;
		background: #10a9bd;
		color: #031013;
		font-size: 0.56rem;
		letter-spacing: 0.14em;
	}

	.book-cover { display: block; width: 100%; height: 100%; object-fit: cover; }
	.book-info { padding: 0 0.25rem; text-align: left; }
	.book-info h3 { margin: 0; font-size: clamp(1.75rem, 7vw, 2.35rem); letter-spacing: -0.025em; line-height: 1.08; }
	.book-author { margin: 1rem 0 0; color: #10a9bd; font-family: var(--font-title); font-size: 1rem; font-weight: 700; }
	.book-genre { margin: 0.75rem 0 0; color: var(--site-text-subtle); font-size: 0.62rem; letter-spacing: 0.15em; }

	.book-highlight {
		margin: 1.65rem 0 0;
		color: var(--site-text-strong);
		font-family: var(--font-title);
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.45;
	}

	.book-synopsis {
		display: -webkit-box;
		margin: 1.35rem 0 0;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 6;
		color: var(--site-text-muted);
		font-size: 1rem;
		line-height: 1.75;
	}

	.book-synopsis strong { color: var(--site-text-strong); font-weight: 700; }

	.book-action {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin-top: 1.75rem;
		padding-bottom: 0.3rem;
		border-bottom: 1px solid #10a9bd;
		color: #10a9bd;
		font-size: 0.66rem;
		letter-spacing: 0.13em;
		text-decoration: none;
		transition: color 0.25s ease, border-color 0.25s ease;
	}

	@media (hover: hover) {
		.book-card:hover .book-cover-wrap { transform: translateY(-8px); box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6); }
		.book-action:hover { border-color: var(--site-text); color: var(--site-text); }
	}

	@media (min-width: 700px) {
		.editorial-hero { min-height: 600px; padding: 6rem 2rem 7rem; }
		.editorial-brand { margin-bottom: 4.5rem; }
		.editorial-icon { width: 66px; height: 66px; }
		.brand-name { font-size: 1.25rem; }
		.hero-copy { font-size: 1.08rem; }
		.books-section { padding: 6rem 2rem 8rem; }
		.books-grid { gap: 6rem; }
		.book-card { grid-template-columns: minmax(150px, 175px) minmax(0, 660px); gap: clamp(2.25rem, 4vw, 3.5rem); }
		.book-cover-wrap { width: 100%; max-width: 175px; }
		.book-info { padding-top: 0.75rem; padding-bottom: 0.5rem; }
		.book-info h3 { font-size: clamp(2rem, 3.5vw, 2.75rem); }
		.book-highlight { font-size: 1.08rem; }
		.book-synopsis { -webkit-line-clamp: 8; font-size: 1.05rem; }
	}

	@media (min-width: 1000px) {
		.books-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4.5rem 2.75rem; }
		.book-card { grid-template-columns: 128px minmax(0, 1fr); gap: 1.5rem; }
		.book-cover-wrap { max-width: 128px; }
		.book-info { padding-top: 0.65rem; }
		.book-info h3 { font-size: clamp(2rem, 2.35vw, 2.35rem); }
		.book-author { margin-top: 0.75rem; }
		.book-genre { margin-top: 0.55rem; }
		.book-highlight { margin-top: 1.25rem; font-size: 1rem; }
		.book-synopsis { margin-top: 1rem; -webkit-line-clamp: 7; font-size: 1rem; line-height: 1.72; }
		.book-action { margin-top: 1.35rem; }
	}

	@media (min-width: 1200px) {
		.book-card { grid-template-columns: 175px minmax(0, 1fr); gap: 1.75rem; }
		.book-cover-wrap { max-width: 175px; }
		.book-info h3 { font-size: 2.05rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.book-cover-wrap { transition: none; }
	}
</style>
