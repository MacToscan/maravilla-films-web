---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Página no encontrada"
	description="La página que buscas no existe o ya no está disponible."
	noindex={true}
>
	<section class="error-page">
		<div class="error-content">
			<p class="error-code" aria-hidden="true">404</p>
			<h1>PÁGINA NO ENCONTRADA</h1>
			<p class="error-message">
				La página que buscas no existe, ha cambiado de dirección o ya no está disponible.
			</p>

			<div class="error-actions">
				<a href="/" class="btn-primary">VOLVER AL INICIO</a>
				<a href="/contact" class="btn-secondary">CONTACTO</a>
			</div>
		</div>
	</section>
</Layout>

<style lang="scss">
	.error-page {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: calc(100svh - 70px);
		padding: 4rem 1.5rem;
		background:
			radial-gradient(circle at center, rgba(0, 80, 251, 0.16), transparent 55%),
			var(--site-bg);
		color: var(--site-text);
		text-align: center;

		@media (min-width: 1024px) {
			min-height: calc(100svh - 218px);
			padding: 5rem 2rem;
		}
	}

	.error-content {
		width: 100%;
		max-width: 700px;
	}

	.error-code {
		margin-bottom: 1rem;
		font-family: var(--font-title);
		font-size: clamp(5rem, 25vw, 10rem);
		font-weight: 700;
		line-height: 0.85;
		letter-spacing: -0.05em;
		color: var(--site-accent);
	}

	h1 {
		margin-bottom: 1.5rem;
		font-family: var(--font-title);
		font-size: clamp(1.5rem, 6vw, 2.5rem);
		letter-spacing: 0.08em;
	}

	.error-message {
		max-width: 560px;
		margin: 0 auto 2.5rem;
		font-size: 1.05rem;
		line-height: 1.7;
		color: rgba(245, 245, 245, 0.75);
	}

	.error-actions {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 1rem;
		max-width: 320px;
		margin: 0 auto;

		@media (min-width: 560px) {
			flex-direction: row;
			justify-content: center;
			max-width: none;
		}
	}

	.btn-primary,
	.btn-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0.85rem 1.5rem;
		border: 1px solid var(--site-accent);
		border-radius: 3px;
		font-family: var(--font-title);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		transition: background-color 0.2s, color 0.2s, transform 0.2s;

		&:hover {
			transform: translateY(-2px);
		}
	}

	.btn-primary {
		background-color: var(--site-accent);
		color: #ffffff;
	}

	.btn-secondary {
		background-color: transparent;
		color: #ffffff;

		&:hover {
			background-color: var(--site-accent);
		}
	}
</style>
