---
import Layout from '../layouts/Layout.astro';

// Aquí tienes la lista del equipo. Cuando tengas las fotos reales, 
// solo tienes que subir la foto a la carpeta public/img/ y cambiar el nombre aquí.
const equipo = [
	{ nombre: "DÍDAC TOSCANO", cargo: "PRODUCTOR EJECUTIVO", imagen: "/img/didacpic.webp" },
	{ nombre: "GONZALO TERRÍN", cargo: "PRODUCTOR EJECUTIVO", imagen: "/img/gonzalopic.webp" },
	{ nombre: "MARC TOSCANO", cargo: "PRODUCTOR EJECUTIVO", imagen: "/img/marcpic.webp" },
	{ nombre: "LUIS ORTUBIA", cargo: "GUIONISTA", imagen: "/img/luispic.webp" },
	{ nombre: "IGNACIO MALAGÓN", cargo: "DIRECTOR", imagen: "/img/maquipic.webp" },
	{ nombre: "ROXANA MARTIN", cargo: "SECRETARIA EJECUTIVA", imagen: "/img/roxanapic.webp" },
	{ nombre: "GABY ARELLANO", cargo: "ADMINISTRADORA", imagen: "/img/gabypic.webp" },
	{ nombre: "PATRICIA ARGIBAY", cargo: "RRPP", imagen: "/img/patripic.webp" },
];
---

<Layout title="Quiénes Somos" description="Conoce al equipo detrás de Cumbre Serena World Productions.">
	
	<main class="about-page">
		
		<section class="about-hero">
			<div class="hero-container">
				<span class="section-badge">LA PRODUCTORA</span>
				<h1 class="hero-title">Cine con identidad, rigor y proyección.</h1>
				
				<div class="hero-description">
					<p>Cumbre Serena nace de la unión de profesionales apasionados por la narrativa cinematográfica. Nuestra filosofía se basa en crear historias con una mirada creativa clara, respaldada por una gestión técnica y financiera precisa.</p>
					<p>Trabajamos con talento emergente y consolidado para desarrollar proyectos que no solo emocionen, sino que tengan una base sólida para viajar internacionalmente.</p>
				</div>
			</div>
		</section>

		<section class="team-section">
			<div class="team-container">
				<h2 class="team-title">EL EQUIPO</h2>
				
				<div class="team-grid">
					{equipo.map((miembro) => (
						<article class="team-card">
							<div class="img-wrapper">
								<img src={miembro.imagen} alt={`Foto de ${miembro.nombre}`} />
							</div>
							<div class="info">
								<h3>{miembro.nombre}</h3>
								<p>{miembro.cargo}</p>
							</div>
						</article>
					))}
				</div>

			</div>
		</section>

	</main>

</Layout>

<style lang="scss">
	/* ==========================================
	   HERO (TEXTOS EN NEGRO - ESTILO INDEX)
	   ========================================== */
	.about-hero {
		background-color: var(--site-bg); /* Fondo negro */
		padding: 6rem 1.5rem 5rem;
		text-align: center;
	}

	.hero-container {
		max-width: 800px;
		margin: 0 auto;
	}

	.section-badge {
		font-family: var(--font-title);
		color: var(--site-accent);
		letter-spacing: 4px;
		font-size: 0.9rem;
		text-transform: uppercase;
		display: block;
		margin-bottom: 1.5rem;
	}

	.hero-title {
		font-family: var(--font-title); 
		font-size: 2rem;
		color: #ffffff;
		line-height: 1.2;
		margin-bottom: 2.5rem;
		
		@media (min-width: 768px) {
			font-size: 2.8rem;
		}
	}

	.hero-description {
		p {
			font-family: var(--font-title);
			font-size: 1.1rem;
			color: rgba(255, 255, 255, 0.7);
			line-height: 1.8;
			margin-bottom: 1.5rem;
			text-align: left;
			
			@media (min-width: 768px) {
				text-align: center;
			}
		}
	}

	/* ==========================================
	   SECCIÓN EQUIPO (EN BLANCO - ESTILO INDEX)
	   ========================================== */
	.team-section {
		background-color: var(--test-bg-page); /* Fondo blanco */
		padding: 5rem 1.5rem 8rem;
	}

	.team-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.team-title {
		font-family: var(--font-title);
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: 4px;
		color: #111; /* Letra oscura para el fondo blanco */
		text-align: center;
		margin-bottom: 4rem;
	}

	/* CSS GRID: MOBILE FIRST */
	.team-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem; 

		@media (min-width: 768px) {
			grid-template-columns: repeat(4, 1fr);
			gap: 2.5rem;
		}
	}

	/* TARJETAS DE PERFIL */
	.team-card {
		.img-wrapper {
			width: 100%;
			aspect-ratio: 4 / 5; 
			overflow: hidden;
			background-color: #f0f0f0; /* Fondo gris clarito por si tarda la foto */
			margin-bottom: 1rem; 
			border-radius: 2px;

			img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				filter: grayscale(100%); 
				transition: filter 0.4s ease, transform 0.4s ease;
			}
		}

		/* EFECTO HOVER PROFESIONAL */
		&:hover {
			.img-wrapper img {
				filter: grayscale(0%);
				transform: scale(1.03);
			}
		}

		.info {
			text-align: left;
			
			h3 {
				font-family: var(--font-title);
				font-size: 0.9rem; 
				font-weight: 700;
				color: #222; /* Letra oscura sobre blanco */
				letter-spacing: 0.5px;
				margin-bottom: 0.2rem;

				@media (min-width: 768px) {
					font-size: 1.1rem;
				}
			}
			p {
				font-family: var(--font-title);
				font-size: 0.7rem; 
				font-weight: 600;
				color: var(--site-accent);
				text-transform: uppercase;
				letter-spacing: 1px;
				margin: 0;
			}
		}
	}
</style>