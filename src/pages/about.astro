---
import Layout from '../layouts/Layout.astro';

const equipo = [
	{ 
		nombre: "CARLOS PINO",
		cargo: "AYUDANTE DE PRODUCCIÓN",
		imagen: "/img/charly.webp",
		bio: ""
	},
	{ 
		nombre: "ALEJANDRA ZAPATA",
		cargo: "DIRECTORA DE RECURSOS HUMANOS (RRHH)",
		imagen: "/img/alejandra.webp",
		bio: ""
	},
	{
		nombre: "CHENCHO RAMOS",
		cargo: "DIRECTOR DE ARTE",
		imagen: "/img/chencho.webp",
		bio: ""
	},
	{
		nombre: "EDUARDO FUSALBA",
		cargo: "",
		imagen: "/img/eduardo.webp",
		bio: ""
	},
	{
		nombre: "ISAAC SALMERÓN",
		cargo: "",
		imagen: "/img/isaac.webp",
		bio: ""
	},
	{
		nombre: "PITER FOT",
		cargo: "DIRECTOR DE FOTOGRAFÍA",
		imagen: "/img/piter.webp",
		bio: ""
	},
	{ 
		nombre: "IGNACIO MALAGÓN", 
		cargo: "DIRECTOR", 
		imagen: "/img/ignacio.webp",
		bio: "Director de gran proyección y profunda sensibilidad artística. Aporta una mirada única para potenciar la emoción y narrativa en cada plano."
	},
	{
		nombre: "MÁXIMO BONATTI",
		cargo: "GUIONISTA",
		imagen: "/img/maximo.webp",
		bio: ""
	},
	{
		nombre: "HÉCTOR NARANJO-GÁMEZ",
		cargo: "DIRECTOR DE CASTING",
		imagen: "/img/hector.webp",
		bio: ""
	},
	{
		nombre: "JULIE DE ROSSI",
		cargo: "ASISTENTE DE DIRECCIÓN",
		imagen: "/img/julie.webp",
		bio: ""
	},
	{ 
		nombre: "GABY ARELLANO", 
		cargo: "ADMINISTRADORA", 
		imagen: "/img/gaby.webp",
		bio: "Profesional con amplia experiencia en el sector. Garantiza el control contable, fiscal y el rigor normativo en todas las fases de producción."
	},
];
---

<Layout
	title="Quiénes somos"
	description="Conoce al equipo de Maravilla Films y nuestra forma de desarrollar historias con identidad, rigor técnico y proyección internacional."
>
	
	<main class="about-page">
		
		<section class="about-hero">
			<div class="hero-container">
				<span class="section-badge">LA PRODUCTORA</span>
				<h1 class="hero-title">Cine con identidad, rigor y proyección.</h1>
				
				<div class="hero-description">
					<p>Maravilla Films nace de la unión de profesionales apasionados por la narrativa cinematográfica. Nuestra filosofía se basa en crear historias con una mirada creativa clara, respaldada por una gestión técnica y financiera precisa.</p>
					<p>Trabajamos con talento emergente y consolidado para desarrollar proyectos que no solo emocionen, sino que tengan una base sólida para viajar internacionalmente.</p>
				</div>
			</div>
		</section>

		<section class="team-section">
			<div class="team-container">
				<h2 class="team-title">EL EQUIPO</h2>
				
				<div class="team-list">
					{equipo.map((miembro) => (
						<article class="team-row">
							<div class="img-wrapper">
								<img src={miembro.imagen} alt={`Foto de ${miembro.nombre}`} loading="lazy" />
							</div>
							<div class="info">
								{miembro.cargo && <p class="cargo">{miembro.cargo}</p>}
								<h3>{miembro.nombre}</h3>
								{miembro.bio && <p class="bio">{miembro.bio}</p>}
							</div>
						</article>
					))}
				</div>

			</div>
		</section>

	</main>

</Layout>

<style lang="scss">
	/* ==========================================
	   HERO (TEXTOS EN NEGRO)
	   ========================================== */
	.about-hero {
		background-color: var(--site-bg); 
		padding: 6rem 1.5rem 5rem;
		text-align: center;
	}

	.hero-container {
		max-width: 800px;
		margin: 0 auto;
	}

	.section-badge {
		font-family: var(--font-title);
		color: var(--site-accent);
		letter-spacing: 4px;
		font-size: 0.9rem;
		text-transform: uppercase;
		display: block;
		margin-bottom: 1.5rem;
	}

	.hero-title {
		font-family: var(--font-title); 
		font-size: 2rem;
		color: #ffffff;
		line-height: 1.2;
		margin-bottom: 2.5rem;
		
		@media (min-width: 768px) {
			font-size: 2.8rem;
		}
	}

	.hero-description {
		p {
			font-family: var(--font-title);
			font-size: 1.1rem;
			color: rgba(255, 255, 255, 0.7);
			line-height: 1.8;
			margin-bottom: 1.5rem;
			text-align: left;
			
			@media (min-width: 768px) {
				text-align: center;
			}
		}
	}

	/* ==========================================
	   SECCIÓN EQUIPO
	   ========================================== */
	.team-section {
		background-color: #000000; /* Fondo negro elegante */
		padding: 2rem 1.5rem 8rem;
	}

	.team-container {
		max-width: 1100px;
		margin: 0 auto;
	}

	.team-title {
		font-family: var(--font-title);
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: 4px;
		color: #ffffff; 
		text-align: center;
		margin-bottom: 4rem;
	}

	/* LISTA DE PERFILES */
	.team-list {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.team-row {
		display: flex;
		flex-direction: column;
		background-color: #0a0a0a;
		border-radius: 8px;
		overflow: hidden;

		@media (min-width: 768px) {
			flex-direction: row;

			&:nth-child(even) {
				flex-direction: row-reverse;
				text-align: right;
			}
		}
	}

	.img-wrapper {
		width: 100%;
		aspect-ratio: 16 / 9;
		flex-shrink: 0;
		overflow: hidden;
		background-color: #050505;

		img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 0.45s ease;
		}

		@media (min-width: 768px) {
			width: 58%;
		}

		@media (hover: hover) and (pointer: fine) {
			&:hover img {
				transform: scale(1.035);
			}
		}
	}

	.info {
		flex: 1;
		padding: 1.5rem;
		text-align: center;

		@media (min-width: 768px) {
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding: 2rem 2.5rem;
			text-align: left;
		}

		.team-row:nth-child(even) & {
			@media (min-width: 768px) {
				text-align: right;
			}
		}
		
		.cargo {
			font-family: var(--font-title);
			font-size: 0.75rem; 
			font-weight: 600;
			color: #b5493b; /* Color rojizo apagado como tu referencia */
			text-transform: uppercase;
			letter-spacing: 2px;
			margin-bottom: 0.5rem;
		}

		h3 {
			font-family: var(--font-title);
			font-size: 1.8rem; 
			font-weight: 700;
			color: #ffffff; 
			letter-spacing: 1px;
			margin-bottom: 1rem;
		}
		
		.bio {
			font-family: var(--font-body);
			font-size: 1rem;
			color: rgba(255, 255, 255, 0.6);
			line-height: 1.6;
			margin: 0;
		}
	}
</style>
