---
import Layout from '../layouts/Layout.astro';

// Añadimos una pequeña bio a cada miembro para que la tarjeta alargada tenga sentido visual
const equipo = [
	{ 
		nombre: "CARLOS PINO",
		cargo: "AYUDANTE DE PRODUCCIÓN",
		imagen: "/img/charly.webp",
		bio: ""
	},
	{ 
		nombre: "GONZALO TERRÍN", 
		cargo: "PRODUCTOR EJECUTIVO", 
		imagen: "/img/gonzalopic.webp",
		bio: ""
	},
	{ 
		nombre: "MARC TOSCANO", 
		cargo: "PRODUCTOR EJECUTIVO", 
		imagen: "/img/marcpic.webp",
		bio: ""
	},
	{ 
		nombre: "IGNACIO MALAGÓN", 
		cargo: "DIRECTOR", 
		imagen: "/img/maquipic.webp",
		bio: "Director de gran proyección y profunda sensibilidad artística. Aporta una mirada única para potenciar la emoción y narrativa en cada plano."
	},
	{ 
		nombre: "ROXANA MARTIN", 
		cargo: "COMMUNITY MANAGER", 
		imagen: "/img/roxanapic.webp",
		bio: "Especialista en redes sociales y estrategia digital. Construye, dinamiza y da voz a la comunidad online de Maravilla Films."
	},
	{ 
		nombre: "GABY ARELLANO", 
		cargo: "ADMINISTRADORA", 
		imagen: "/img/gabypic.webp",
		bio: "Profesional con amplia experiencia en el sector. Garantiza el control contable, fiscal y el rigor normativo en todas las fases de producción."
	},
];
---

<Layout
	title="Quiénes somos"
	description="Conoce al equipo de Maravilla Films y nuestra forma de desarrollar historias con identidad, rigor técnico y proyección internacional."
>
	
	<main class="about-page">
		
		<section class="about-hero">
			<div class="hero-container">
				<span class="section-badge">LA PRODUCTORA</span>
				<h1 class="hero-title">Cine con identidad, rigor y proyección.</h1>
				
				<div class="hero-description">
					<p>Maravilla Films nace de la unión de profesionales apasionados por la narrativa cinematográfica. Nuestra filosofía se basa en crear historias con una mirada creativa clara, respaldada por una gestión técnica y financiera precisa.</p>
					<p>Trabajamos con talento emergente y consolidado para desarrollar proyectos que no solo emocionen, sino que tengan una base sólida para viajar internacionalmente.</p>
				</div>
			</div>
		</section>

		<section class="team-section">
			<div class="team-container">
				<h2 class="team-title">EL EQUIPO</h2>
				
				<div class="team-list">
					{equipo.map((miembro) => (
						<article class="team-row">
							<div class="img-wrapper">
								<img src={miembro.imagen} alt={`Foto de ${miembro.nombre}`} loading="lazy" />
							</div>
							<div class="info">
								<p class="cargo">{miembro.cargo}</p>
								<h3>{miembro.nombre}</h3>
								<p class="bio">{miembro.bio}</p>
							</div>
						</article>
					))}
				</div>

			</div>
		</section>

	</main>

</Layout>

<style lang="scss">
	/* ==========================================
	   HERO (TEXTOS EN NEGRO)
	   ========================================== */
	.about-hero {
		background-color: var(--site-bg); 
		padding: 6rem 1.5rem 5rem;
		text-align: center;
	}

	.hero-container {
		max-width: 800px;
		margin: 0 auto;
	}

	.section-badge {
		font-family: var(--font-title);
		color: var(--site-accent);
		letter-spacing: 4px;
		font-size: 0.9rem;
		text-transform: uppercase;
		display: block;
		margin-bottom: 1.5rem;
	}

	.hero-title {
		font-family: var(--font-title); 
		font-size: 2rem;
		color: #ffffff;
		line-height: 1.2;
		margin-bottom: 2.5rem;
		
		@media (min-width: 768px) {
			font-size: 2.8rem;
		}
	}

	.hero-description {
		p {
			font-family: var(--font-title);
			font-size: 1.1rem;
			color: rgba(255, 255, 255, 0.7);
			line-height: 1.8;
			margin-bottom: 1.5rem;
			text-align: left;
			
			@media (min-width: 768px) {
				text-align: center;
			}
		}
	}

	/* ==========================================
	   SECCIÓN EQUIPO (MINIMALISTA, ALARGADO, PEQUEÑO)
	   ========================================== */
	.team-section {
		background-color: #000000; /* Fondo negro elegante */
		padding: 2rem 1.5rem 8rem;
	}

	.team-container {
		max-width: 900px; /* Contenedor más estrecho para que sea recogido */
		margin: 0 auto;
	}

	.team-title {
		font-family: var(--font-title);
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: 4px;
		color: #ffffff; 
		text-align: center;
		margin-bottom: 4rem;
	}

	/* LISTA DE PERFILES */
	.team-list {
		display: flex;
		flex-direction: column;
		gap: 2rem; /* Separación entre cada tarjeta */
	}

	/* TARJETAS ALARGADAS */
	.team-row {
		display: flex;
		flex-direction: column;
		align-items: center;
		background-color: #0a0a0a; /* Fondo sutil para la tarjeta */
		border-radius: 8px;
		padding: 2rem;
		gap: 2rem;

		/* VERSIÓN ESCRITORIO: ALINEACIÓN Y ALTERNANCIA */
		@media (min-width: 768px) {
			flex-direction: row; /* Imagen a la izquierda, texto a la derecha */
			align-items: center;
			padding: 2rem 3rem;

			/* Aquí hacemos que el segundo, cuarto, sexto... se inviertan (imagen derecha) */
			&:nth-child(even) {
				flex-direction: row-reverse;
				text-align: right; /* Alineamos el texto a la derecha para equilibrar */
			}
		}
	}

	/* CONTENEDOR DE LA IMAGEN (TAMAÑO FIJO Y PEQUEÑO) */
	.img-wrapper {
		width: 100%;
		max-width: 180px; /* ¡CLAVE! Tamaño máximo muy pequeño y controlado */
		aspect-ratio: 4 / 5; /* Mantenemos tu proporción original de la tarjeta[cite: 5] */
		flex-shrink: 0; /* Evita que la foto se encoja si hay mucho texto */
		border-radius: 4px;
		overflow: hidden;
		background-color: #1a1a1a;

		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			filter: grayscale(80%); 
			transition: filter 0.4s ease, transform 0.4s ease;
		}

		/* EFECTO HOVER PROFESIONAL[cite: 5] */
		&:hover img {
			filter: grayscale(0%);
			transform: scale(1.03);
		}
	}

	/* TEXTO DE LA TARJETA */
	.info {
		flex: 1; /* Ocupa el resto del espacio disponible */
		
		.cargo {
			font-family: var(--font-title);
			font-size: 0.75rem; 
			font-weight: 600;
			color: #b5493b; /* Color rojizo apagado como tu referencia */
			text-transform: uppercase;
			letter-spacing: 2px;
			margin-bottom: 0.5rem;
		}

		h3 {
			font-family: var(--font-title);
			font-size: 1.8rem; 
			font-weight: 700;
			color: #ffffff; 
			letter-spacing: 1px;
			margin-bottom: 1rem;
		}
		
		.bio {
			font-family: var(--font-body);
			font-size: 1rem;
			color: rgba(255, 255, 255, 0.6);
			line-height: 1.6;
			margin: 0;
		}
	}
</style>
