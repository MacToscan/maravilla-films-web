---
import Layout from '../layouts/Layout.astro';

const equipo = [
	{
		nombre: "IGNACIO MALAGÓN",
		cargo: "DIRECTOR",
		imagen: "/img/ignacio.webp",
		bio: "Luces, cámara, Malagón."
	},
	{
		nombre: "TRISTÁN-LUA VIGNOLO",
		cargo: "DIRECTOR DE PRODUCCIÓN",
		imagen: "/img/tristan.webp",
		bio: "Dicen que intentó reducir tanto un presupuesto, que ahora le deben dinero."
	},
	{
		nombre: "PITER FOT",
		cargo: "DIRECTOR DE FOTOGRAFÍA",
		imagen: "/img/piter.webp",
		bio: "Piter no ilumina una escena. Le explica a la oscuridad dónde colocarse."
	},
	{
		nombre: "CHENCHO RAMOS",
		cargo: "DIRECTOR DE ARTE",
		imagen: "/img/chencho.webp",
		bio: "Construyó una puerta falsa en la pared y el director intentó abrirla cuatro veces."
	},
	{
		nombre: "HÉCTOR NARANJO-GÁMEZ",
		cargo: "DIRECTOR DE CASTING",
		imagen: "/img/hector.webp",
		bio: "Un gran bigote conlleva una gran responsabilidad."
	},
	{
		nombre: "MARTA ROIG",
		cargo: "JEFA DE PRODUCCIÓN",
		imagen: "/img/marta.webp",
		bio: "Organizó tan bien un rodaje que hasta los imprevistos llegaron a tiempo."
	},
	{
		nombre: "CARLOS PINO",
		cargo: "AYUDANTE DE PRODUCCIÓN",
		imagen: "/img/charly.webp",
		bio: "A grandes probelmas... grandes Charlys."
	},
	{
		nombre: "ISAAC SALMERÓN",
		cargo: "JEFE DE LOCALIZACIONES",
		imagen: "/img/isaac.webp",
		bio: "Isaac encontró una localización que todavía no existía."
	},
	{
		nombre: "ADRIÀ RODRÍGUEZ",
		cargo: "AYUDANTE DE DIRECCIÓN",
		imagen: "/img/adria.webp",
		bio: "Un corcho para controlarlos a todos."
	},
	{
		nombre: "EDUARDO FUSALBA",
		cargo: "DECORADOR",
		imagen: "/img/eduardo.webp",
		bio: "Más peligroso que McGyver en un laboratorio de química."
	},
	{
		nombre: "JULIA CENDRERO",
		cargo: "AUXILIAR DE DECORACIÓN",
		imagen: "/img/julia.webp",
		bio: "Más liada que la pata de un romano."
	},
	{
		nombre: "JULIE DE ROSSI",
		cargo: "2ª AYUDANTE DE DIRECCIÓN",
		imagen: "/img/julie.webp",
		bio: "Un paso por delante del ayudante... por si se pierde."
	},
	{
		nombre: "ALEJANDRA ZAPATA",
		cargo: "DIRECTORA DE RECURSOS HUMANOS (RRHH)",
		imagen: "/img/alejandra.webp",
		bio: "Cuando los humanos se quedan sin recursos, ahi está ella."
	},
	{
		nombre: "GABY ARELLANO",
		cargo: "DIRECTORA DE ADMINISTRACIÓN",
		imagen: "/img/gaby.webp",
		bio: "Los números le van a hacer perder la cabeza, pero nunca una factura."
	},
];

const productoresEjecutivos = [
	"DÍDAC TOSCANO",
	"GONZALO TERRÍN",
	"EDUARDO ÁLVAREZ",
	"MARC TOSCANO",
];
---

<Layout
	title="Quiénes somos"
	description="Conoce al equipo de Maravilla Films y nuestra forma de desarrollar historias con identidad, rigor técnico y proyección internacional."
>
	
	<main class="about-page">
		
		<section class="about-hero">
			<div class="hero-container">
				<span class="section-badge">LA PRODUCTORA</span>
				<h1 class="hero-title">Cine con identidad, rigor y proyección.</h1>
				
				<div class="hero-description">
					<p>Maravilla Films nace de la unión de profesionales apasionados por la narrativa cinematográfica. Nuestra filosofía se basa en crear historias con una mirada creativa clara, respaldada por una gestión técnica y financiera precisa.</p>
					<p>Trabajamos con talento emergente y consolidado para desarrollar proyectos que no solo emocionen, sino que tengan una base sólida para viajar internacionalmente.</p>
				</div>
			</div>
		</section>

		<section class="team-section">
			<div class="team-container">
				<h2 class="team-title">EL EQUIPO</h2>
				
				<div class="team-list">
					{equipo.map((miembro) => (
						<article class="team-row">
							<div class="img-wrapper">
								<img src={miembro.imagen} alt={`Foto de ${miembro.nombre}`} loading="lazy" />
							</div>
							<div class="info">
								{miembro.cargo && <p class="cargo">{miembro.cargo}</p>}
								<h3>{miembro.nombre}</h3>
								{miembro.bio && <p class="bio">{miembro.bio}</p>}
							</div>
						</article>
					))}
				</div>

				<section class="executive-section" aria-labelledby="executive-title">
					<h2 id="executive-title" class="executive-title">
						LOS QUE DICEN: <span>«VALE, PERO ESO... ¿CUÁNTO CUESTA?»</span>
					</h2>
					<div class="executive-tree">
						{productoresEjecutivos.map((nombre) => (
							<p class="executive-name">{nombre}</p>
						))}
					</div>
				</section>

			</div>
		</section>

	</main>

</Layout>

<style lang="scss">
	/* ==========================================
	   HERO (TEXTOS EN NEGRO)
	   ========================================== */
	.about-hero {
		background-color: var(--site-bg); 
		padding: 6rem 1.5rem 5rem;
		text-align: center;
	}

	.hero-container {
		max-width: 800px;
		margin: 0 auto;
	}

	.section-badge {
		font-family: var(--font-title);
		color: var(--site-accent);
		letter-spacing: 4px;
		font-size: 0.9rem;
		text-transform: uppercase;
		display: block;
		margin-bottom: 1.5rem;
	}

	.hero-title {
		font-family: var(--font-title); 
		font-size: 2rem;
		color: #ffffff;
		line-height: 1.2;
		margin-bottom: 2.5rem;
		
		@media (min-width: 768px) {
			font-size: 2.8rem;
		}
	}

	.hero-description {
		p {
			font-family: var(--font-title);
			font-size: 1.1rem;
			color: rgba(255, 255, 255, 0.7);
			line-height: 1.8;
			margin-bottom: 1.5rem;
			text-align: left;
			
			@media (min-width: 768px) {
				text-align: center;
			}
		}
	}

	/* ==========================================
	   SECCIÓN EQUIPO
	   ========================================== */
	.team-section {
		background-color: #000000; /* Fondo negro elegante */
		padding: 2rem 1.5rem 8rem;
	}

	.team-container {
		max-width: 1100px;
		margin: 0 auto;
	}

	.team-title {
		font-family: var(--font-title);
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: 4px;
		color: #ffffff; 
		text-align: center;
		margin-bottom: 4rem;
	}

	/* LISTA DE PERFILES */
	.team-list {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.team-row {
		display: flex;
		flex-direction: column;
		background-color: #0a0a0a;
		border-radius: 8px;
		overflow: hidden;

		@media (min-width: 768px) {
			flex-direction: row;

			&:nth-child(even) {
				flex-direction: row-reverse;
				text-align: right;
			}
		}
	}

	.img-wrapper {
		width: 100%;
		aspect-ratio: 16 / 9;
		flex-shrink: 0;
		overflow: hidden;
		background-color: #050505;

		img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 0.45s ease;
		}

		@media (min-width: 768px) {
			width: 58%;
		}

		@media (hover: hover) and (pointer: fine) {
			&:hover img {
				transform: scale(1.035);
			}
		}
	}

	.info {
		flex: 1;
		padding: 1.5rem;
		text-align: center;

		@media (min-width: 768px) {
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding: 2rem 2.5rem;
			text-align: left;
		}

		.team-row:nth-child(even) & {
			@media (min-width: 768px) {
				text-align: right;
			}
		}
		
		.cargo {
			font-family: var(--font-title);
			font-size: 0.75rem; 
			font-weight: 600;
			color: #b5493b; /* Color rojizo apagado como tu referencia */
			text-transform: uppercase;
			letter-spacing: 2px;
			margin-bottom: 0.5rem;
		}

		h3 {
			font-family: var(--font-title);
			font-size: 1.8rem; 
			font-weight: 700;
			color: #ffffff; 
			letter-spacing: 1px;
			margin-bottom: 1rem;
		}
		
		.bio {
			font-family: var(--font-body);
			font-size: 1rem;
			color: rgba(255, 255, 255, 0.6);
			line-height: 1.6;
			margin: 0;
		}
	}

	/* ==========================================
	   PRODUCTORES EJECUTIVOS
	   ========================================== */
	.executive-section {
		margin-top: 7rem;
		text-align: center;
	}

	.executive-title {
		position: relative;
		display: inline-flex;
		flex-direction: column;
		gap: 0.45rem;
		max-width: 760px;
		margin: 0 auto 3rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 8px;
		background: #0a0a0a;
		font-family: var(--font-title);
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1.5;
		letter-spacing: 2px;
		color: var(--site-accent);

		span {
			font-size: 1.05rem;
			font-weight: 700;
			letter-spacing: 1px;
			color: #ffffff;
		}

		&::after {
			content: "";
			position: absolute;
			top: 100%;
			left: 50%;
			width: 1px;
			height: 3rem;
			background: rgba(255, 255, 255, 0.22);
		}

		@media (min-width: 768px) {
			padding: 1.4rem 2.5rem;
			font-size: 0.8rem;

			span {
				font-size: 1.3rem;
			}
		}
	}

	.executive-tree {
		position: relative;
		display: grid;
		gap: 0.85rem;
		margin-left: 1rem;
		padding-left: 1.5rem;
		border-left: 1px solid rgba(255, 255, 255, 0.22);

		&::before {
			content: "";
			position: absolute;
			bottom: 100%;
			left: 0;
			width: calc(50% - 1rem);
			height: 1px;
			background: rgba(255, 255, 255, 0.22);
		}

		@media (min-width: 768px) {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 1rem;
			margin-left: 0;
			padding-top: 2rem;
			padding-left: 0;
			border-left: 0;

			&::before {
				display: none;
			}

			&::after {
				content: "";
				position: absolute;
				top: 0;
				left: 12.5%;
				right: 12.5%;
				height: 1px;
				background: rgba(255, 255, 255, 0.22);
			}
		}
	}

	.executive-name {
		position: relative;
		margin: 0;
		padding: 1.2rem 1rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 6px;
		background: #0a0a0a;
		font-family: var(--font-title);
		font-size: 1.4rem;
		font-weight: 700;
		letter-spacing: 1px;
		color: rgba(255, 255, 255, 0.86);

		&::before {
			content: "";
			position: absolute;
			top: 50%;
			right: 100%;
			width: 1.5rem;
			height: 1px;
			background: rgba(255, 255, 255, 0.22);
		}

		@media (min-width: 768px) {
			&::before {
				top: auto;
				right: auto;
				bottom: 100%;
				left: 50%;
				width: 1px;
				height: 2rem;
			}
		}
	}
</style>
