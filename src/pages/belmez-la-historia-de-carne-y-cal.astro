---
import Layout from '../layouts/Layout.astro';

const officialDescription = 'Largometraje inspirado en la novela Carne y cal de Martín Barroso, producido por Maravilla Films y dirigido por Eduardo Álvarez.';

const filmStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'Movie',
	'@id': 'https://maravillafilms.com/belmez-la-historia-de-carne-y-cal#movie',
	name: 'Bélmez: La historia de Carne y cal',
	url: 'https://maravillafilms.com/belmez-la-historia-de-carne-y-cal',
	image: 'https://maravillafilms.com/img/carneycal_portada_opt.webp',
	description: officialDescription,
	director: { '@type': 'Person', name: 'Eduardo Álvarez' },
	productionCompany: { '@id': 'https://maravillafilms.com/#organization' },
	isBasedOn: {
		'@type': 'Book',
		name: 'Carne y cal',
		author: { '@type': 'Person', name: 'Martín Barroso' },
	},
	inLanguage: 'es',
};
---

<Layout
	title="Bélmez: La historia de Carne y cal — Largometraje"
	description={officialDescription}
	socialImage="/img/carneycal_portada_opt.webp"
	socialImageAlt="Cartel de Bélmez: La historia de Carne y cal"
	socialImageWidth={1000}
	socialImageHeight={1400}
	structuredData={filmStructuredData}
>
	<main class="project-page">
		<section class="project-hero" aria-labelledby="project-title">
			<div class="poster-wrap">
				<img
					src="/img/carneycal_portada_opt.webp"
					alt="Cartel de Bélmez: La historia de Carne y cal"
					class="project-poster"
					width="1000"
					height="1400"
				/>
			</div>

			<div class="project-copy">
				<p class="project-format">LARGOMETRAJE</p>
				<h1 id="project-title">BÉLMEZ</h1>
				<p class="project-subtitle">LA HISTORIA DE CARNE Y CAL</p>
				<p class="project-status"><span aria-hidden="true"></span> EN PREPRODUCCIÓN</p>
				<p class="project-description">
					Largometraje inspirado en la novela <cite>Carne y cal</cite> de <strong>Martín Barroso</strong>,
					producido por <strong>Maravilla Films</strong> y dirigido por <strong>Eduardo Álvarez</strong>.
				</p>
				<a class="back-link" href="/catalogo">
					<span aria-hidden="true">←</span> VOLVER AL CATÁLOGO
				</a>
			</div>
		</section>
	</main>
</Layout>

<style lang="scss">
	.project-page {
		min-height: 72vh;
		background:
			radial-gradient(circle at 18% 45%, rgba(115, 65, 25, 0.18), transparent 38%),
			var(--site-bg);
		color: var(--site-text);
	}

	.project-hero {
		width: min(100% - 2rem, 1080px);
		margin: 0 auto;
		padding: clamp(3rem, 8vw, 7rem) 0;
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	.poster-wrap {
		width: min(78vw, 360px);
		margin: 0 auto;
		padding: 8px;
		background: rgba(255, 255, 255, 0.035);
		border: 1px solid var(--site-border);
		box-shadow: 0 28px 70px rgba(0, 0, 0, 0.48);
	}

	.project-poster {
		display: block;
		width: 100%;
		height: auto;
	}

	.project-copy {
		max-width: 600px;
	}

	.project-format,
	.project-status,
	.back-link {
		font-family: var(--font-title);
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.project-format {
		margin-bottom: 1.1rem;
		color: var(--site-accent);
		font-size: 0.74rem;
	}

	h1 {
		font-size: clamp(3.15rem, 11vw, 7.2rem);
		line-height: 0.82;
		letter-spacing: -0.045em;
	}

	.project-subtitle {
		margin-top: 0.7rem;
		font-family: var(--font-title);
		font-size: clamp(0.9rem, 2.5vw, 1.3rem);
		font-weight: 500;
		letter-spacing: 0.19em;
		color: var(--site-text-soft);
	}

	.project-status {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-top: 2rem;
		font-size: 0.72rem;
		color: var(--site-text-muted);
	}

	.project-status span {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--site-accent);
		box-shadow: 0 0 14px rgba(0, 80, 251, 0.72);
	}

	.project-description {
		margin-top: 1.65rem;
		padding-top: 1.65rem;
		border-top: 1px solid var(--site-border);
		font-size: clamp(1.12rem, 2.2vw, 1.45rem);
		line-height: 1.75;
		color: var(--site-text-soft);
	}

	.project-description strong,
	.project-description cite {
		color: var(--site-text-strong);
		font-weight: 600;
	}

	.project-description cite { font-style: italic; }

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		margin-top: 2.2rem;
		padding-bottom: 0.35rem;
		border-bottom: 1px solid var(--site-border-strong);
		font-size: 0.68rem;
		color: var(--site-text-muted);
		transition: color 180ms ease, border-color 180ms ease;
	}

	.back-link:hover,
	.back-link:focus-visible {
		color: var(--site-text);
		border-color: var(--site-accent);
	}

	@media (min-width: 760px) {
		.project-hero {
			grid-template-columns: minmax(280px, 390px) minmax(0, 1fr);
			gap: clamp(3.5rem, 8vw, 7rem);
		}

		.poster-wrap { width: 100%; }
	}

	@media (prefers-reduced-motion: reduce) {
		.back-link { transition: none; }
	}
</style>
